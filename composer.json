{
    "name": "qinii/wechat-core",
    "description": "Common infrastructure for Qinii WeChat business packages built on EasyWeChat 6.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "psr/container": "^2.0",
        "symfony/http-client": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "suggest": {
        "ext-swoole": "Required when using Qinii\\WechatCore\\Http\\SwooleHttpClient"
    },
    "autoload": {
        "psr-4": {
            "Qinii\\WechatCore\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
